<?xml version="1.0" encoding="utf-8"?>
<!--
  Disabilita l'estrazione dei dati dell'app per cloud backup e device transfer.
  Evita che token di autenticazione e cache Firebase finiscano in backup
  esterni (Google Drive) recuperabili da terzi. (Android 12+)
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
