rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ─── users/{userId} — PROFILO PRIVATO ──────────────────────────────────
    // Contiene reddito, spese fisse, categorie, achievement.
    // Leggibile e scrivibile SOLO dal proprietario. Nessun altro utente
    // (nemmeno i familiari) può leggere i dati finanziari grezzi.
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ─── families/{familyId} — DIRECTORY CONDIVISA ─────────────────────────
    // Contiene SOLO dati non sensibili: nomi, colori, uid dei membri.
    // NIENTE reddito, spese o transazioni. familyId == uid del creatore.
    match /families/{familyId} {
      // Lettura: qualsiasi utente autenticato (serve per l'invito).
      allow read: if isSignedIn();

      // Creazione: solo il creatore, e deve includere se stesso.
      allow create: if isOwner(familyId)
        && request.resource.data.memberUids is list
        && request.resource.data.memberUids.hasAll([familyId]);

      // Aggiornamento:
      //  - il creatore può fare tutto;
      //  - un partner può SOLO aggiungersi: mantiene i membri esistenti,
      //    aggiunge esattamente il proprio uid, tocca solo members/memberUids.
      allow update: if isOwner(familyId)
        || (
          isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberUids'])
          && request.resource.data.memberUids.hasAll(resource.data.memberUids)
          && request.resource.data.memberUids.hasAll([request.auth.uid])
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
        );

      // Nessuno può cancellare la directory famiglia via client.
      allow delete: if false;
    }

    // ─── transactions/{txId} — SPESE CONDIVISE PER FAMIGLIA ────────────────
    match /transactions/{txId} {
      // Lettura: una mia transazione, oppure appartengo alla famiglia
      // a cui è associata (verifica su families/{familyId}.memberUids).
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        request.auth.uid in get(/databases/$(database)/documents/families/$(resource.data.familyId)).data.memberUids
      );

      // Creazione: deve essere una transazione MIA + validazione campi
      // (evita importi negativi/assurdi e date malformate da client malevoli).
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount < 1000000
        && request.resource.data.date is string
        && request.resource.data.date.size() == 10;

      // Modifica/cancella: solo chi l'ha creata.
      allow update, delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }
  }
}
